[Unit]
Description=mi50-oc — Apply PowerPlay table tweaks for AMD Radeon Pro VII / MI50
After=multi-user.target
Before=lightdm.service gdm.service sddm.service

[Service]
Type=oneshot
ExecStartPre=/bin/bash -c 'while [ ! -f /sys/class/drm/card0/device/pp_table ]; do sleep 1; done'
ExecStart=/usr/local/bin/mi50-apply-pp.sh /etc/mi50-oc/pp_table_active.bin
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
